# AZ-IR environment. Copy to .env (never commit it) or set these in your PaaS dashboard.
# Every variable is prefixed AZIR_ and read by backend/src/azir/core/config.py.

# --- runtime ---------------------------------------------------------------
AZIR_ENV=development              # development | staging | production
AZIR_DEBUG=false
AZIR_LOG_LEVEL=INFO

# --- data access (ADR-0014) -------------------------------------------------
# fixtures: YAML corpus in memory, no database needed (development, demos, tests)
# postgis:  PostgreSQL + PostGIS (staging, production -- required there)
AZIR_DB_DRIVER=fixtures
AZIR_DB_URL=postgresql+psycopg2://azir:azir@localhost:5432/azir
AZIR_DB_POOL_SIZE=5
AZIR_DB_MAX_OVERFLOW=10
AZIR_DB_STATEMENT_TIMEOUT_MS=5000
AZIR_FIXTURES_DIR=backend/seeds/fixtures

# --- api --------------------------------------------------------------------
AZIR_API_PREFIX=/api/v1
AZIR_DEFAULT_LOCALE=fa
AZIR_SUPPORTED_LOCALES=["fa","en"]
AZIR_CORS_ORIGINS=["http://localhost:3000"]
AZIR_MAX_PAYLOAD_KB=512
AZIR_MAX_LIMIT=2000
AZIR_DEFAULT_LIMIT=800

# --- study area and timeline -------------------------------------------------
AZIR_STUDY_AREA_BBOX=[44.0,35.5,49.5,39.8]
AZIR_STUDY_AREA_CENTER=[47.0,38.0]
AZIR_DEFAULT_ZOOM=6.4
AZIR_TIMELINE_FLOOR=-800
AZIR_TIMELINE_CEIL=2026
AZIR_TIMELINE_DEFAULT_YEAR=1500
AZIR_TIMELINE_BUCKETS=[1,5,25,100,500]

# --- frontend (frontend/.env.local or the PaaS env) --------------------------
# The Next.js server proxies /api/* here; browsers never talk to the backend directly.
AZIR_BACKEND_URL=http://127.0.0.1:8000

# --- tests -------------------------------------------------------------------
# When set, the repository contract suite also runs against a real PostGIS database.
# AZIR_TEST_DB_URL=postgresql+psycopg2://azir:azir@localhost:5432/azir_test
